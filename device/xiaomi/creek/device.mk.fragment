# Add this line to device/xiaomi/creek/device.mk:
PRODUCT_PACKAGES += \
    LunarisDolby

# Copy LunarisDolby privileged-app permissions.
PRODUCT_COPY_FILES += \
    $(LOCAL_PATH)/configs/permissions/privapp-permissions-dolby.xml:$(TARGET_COPY_OUT_SYSTEM_EXT)/etc/permissions/privapp-permissions-dolby.xml \
    $(LOCAL_PATH)/configs/sysconfig/hiddenapi-whitelist-dolby.xml:$(TARGET_COPY_OUT_SYSTEM_EXT)/etc/sysconfig/hiddenapi-whitelist-dolby.xml
